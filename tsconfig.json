{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],

		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "*.config.ts", "eslint.config.js"]
}
